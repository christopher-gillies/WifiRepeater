# Default SDK Configuration for WiFi Repeater Project
# Freenove ESP32-S3 WROOM-1 (16MB Flash / 8MB PSRAM)

# Console UART Baud Rate
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Flash Size (16MB)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM Configuration
#CONFIG_ESP32S3_SPIRAM_SUPPORT=y
#CONFIG_SPIRAM_MODE_QUAD=y
#CONFIG_SPIRAM_SPEED_80M=y

# WiFi Configuration
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=0

# lwIP Stack Configuration
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_IPV4_NAPT_PORTMAP=y
CONFIG_LWIP_L2_TO_L3_COPY=y
CONFIG_LWIP_TCP_MSS=1460
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760

# Memory Configuration
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Logging
CONFIG_LOG_DEFAULT_LEVEL=3

# FreeRTOS
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_TICK_RATE_HZ=1000

# Disable unused components to avoid compiler crashes
CONFIG_ESP_LCD_ENABLE_DEBUG_LOG=n
